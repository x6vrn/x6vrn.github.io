    },
    "\n",
    {
      "tag": "p",
      "props": {},
      "children": [
        "ok now we know what is Web IDL"
      ]
    },
    "\n",
    {
      "tag": "p",
      "props": {},
      "children": [
        {
          "tag": "a",
          "props": {
            "href": "https://source.chromium.org/chromium/chromium/src/+/main:third_party/blink/renderer/core/frame/window.idl;l=62",
            "rel": "noopener noreferrer",
            "target": "_blank"
          },
          "children": [
            {
              "tag": "code",
              "props": {},
              "children": [
                "third_party/blink/renderer/core/frame/window.idl:62"
              ]
            }
          ]
        }
      ]
    },
    "\n",
    {
      "tag": "pre",
      "props": {
        "tabIndex": 0
      },
      "children": [
        {
          "tag": "code",
